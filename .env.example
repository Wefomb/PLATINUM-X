# Runtime environment
NODE_ENV=production
PORT=3000
SERVER_PORT=

# SQLite persistent storage path (directory is created automatically if missing)
SQLITE_PATH=./data/platinum-x.db

# Security & site URL
SESSION_SECRET=change-me-in-production-to-a-long-random-string
PUBLIC_SITE_URL=http://localhost:3000

# Catalog pricing mode: "enquiry" (matches Figma Studio Release) or "priced"
CATALOG_MODE=enquiry

# Optional payment provider ("development" or "stripe")
PAYMENT_PROVIDER=development
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
